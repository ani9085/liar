# 로컬 실행용 예시. 이 파일을 .env 로 복사해서 값을 넣으세요. (.env 는 git에 올라가지 않습니다)
# Vercel에서는 Project Settings → Environment Variables 에 같은 이름으로 넣으면 됩니다.

# OpenRouter API 키 (https://openrouter.ai/keys). 없으면 규칙 판별만 사용합니다.
OPENROUTER_API_KEY=

# 사용할 모델 (https://openrouter.ai/models 의 모델 ID). 비워두면 anthropic/claude-opus-5.5
OPENROUTER_MODEL=

# 1 이면 키가 있어도 AI 판별을 끕니다.
AI_DISABLED=
